{
  "name": "ping-spike-monitor",
  "version": "0.1.0",
  "description": "A Windows desktop monitor for latency, packet loss, jitter, and regional network incidents.",
  "main": "out/main/index.js",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "pnpm build && playwright test test/electron.spec.ts --workers=1",
    "typecheck": "tsc --noEmit",
    "package": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "io.pingspikemonitor.desktop",
    "productName": "Ping Spike Monitor",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/app-logo.png",
        "to": "app-logo.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/app-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
